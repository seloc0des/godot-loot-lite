; Demo / dev project for Loot — Lite.

config_version=5

[application]

config/name="Loot (Lite) · Demo"
config/description="Free weighted-table loot rolling for Godot 4.3+."
config/features=PackedStringArray("4.5", "GL Compatibility")
run/main_scene="res://demo/loot_demo.tscn"

[display]

window/size/viewport_width=900
window/size/viewport_height=520

[editor_plugins]

enabled=PackedStringArray("res://addons/loot_lite/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
